# ================================================
# Projeto Full Stack: Node.js / NestJS / React
# ================================================

# Dependências (raiz e subpastas)
node_modules/
**/node_modules/

# Builds e artefatos gerados
**/dist/
**/build/
**/coverage/
**/.nyc_output/
**/.vite/
**/.next/
**/.turbo/
**/.cache/
**/out/
*.tsbuildinfo
*.tsbuildinfo.*

# Logs de execução
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/logs/

# Variáveis locais e segredos
.env
.env.*
**/.env
**/.env.*

# Modelos de ambiente podem e devem ser versionados
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Chaves/certificados privados
*.pem
*.p12
*.pfx
*.key

# Bancos locais e volumes gerados (se usados)
/mongo-data/
/mongodb-data/
/backend/mongo-data/
/backend/mongodb-data/
*.sqlite
*.sqlite3

# Resultados de testes E2E
**/playwright-report/
**/test-results/

# Diretórios temporários
**/tmp/
**/temp/
*.tmp
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
Desktop.ini

# Configurações locais de IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Plataformas de deploy (se aplicável)
**/.vercel/
**/.netlify/

# IMPORTANTE: NÃO ignorar package-lock.json, yarn.lock ou pnpm-lock.yaml.
# Eles ajudam a reproduzir versões das dependências.
